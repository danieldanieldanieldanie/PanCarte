rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /cards/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
