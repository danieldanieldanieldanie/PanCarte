rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function isOwner(uid){ return signedIn() && request.auth.uid == uid; }
    match /counters/{id} { allow read: if signedIn(); allow update, create: if signedIn() && id == 'global' && request.resource.data.nextUserNumber is int; }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid;
    }
    match /contacts/{uid}/items/{contactId} {
      allow read, create, update, delete: if isOwner(uid);
    }
    match /deliveries/{deliveryId} {
      allow create: if signedIn() && request.resource.data.senderUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow delete: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if false;
    }
    match /archives/{uid}/cards/{cardId} {
      allow read, write: if isOwner(uid);
    }
  }
}
